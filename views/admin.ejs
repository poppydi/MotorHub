<%- include('partials/head') %>
<%- include('partials/header', { currentPath: '/admin', categories: typeof categories !== 'undefined' ? categories : [] }) %>
<main class="main-content admin-main">
  <aside class="admin-sidebar">
    <h3>Админ-панель</h3>
    <nav class="admin-nav">
      <a href="#users" class="admin-nav-link">Пользователи</a>
      <a href="#products" class="admin-nav-link">Товары</a>
      <a href="#orders" class="admin-nav-link">Заказы</a>
    </nav>
  </aside>
  <div class="admin-content">
    <% if (typeof flash !== 'undefined' && flash) { %>
      <p class="admin-flash success-msg"><%= flash %></p>
    <% } %>
    <% if (typeof adminError !== 'undefined' && adminError === 'password') { %>
      <p class="admin-flash auth-error">Пароль должен быть не менее 6 символов</p>
    <% } %>
    <section id="users" class="admin-section">
      <h2>Пользователи</h2>
      <form action="/admin/users" method="post" class="admin-form">
        <input type="email" name="email" placeholder="Email" required>
        <input type="password" name="password" placeholder="Пароль" required>
        <input type="text" name="name" placeholder="Имя" required>
        <input type="text" name="surname" placeholder="Фамилия">
        <select name="role">
          <option value="customer">Покупатель</option>
          <option value="manager">Менеджер</option>
          <option value="admin">Админ</option>
        </select>
        <button type="submit" class="btn btn-solid">Добавить</button>
      </form>
      <div class="table-scroll">
        <table class="admin-table admin-table-users">
          <thead>
            <tr><th class="col-id">ID</th><th>Email</th><th>Имя</th><th>Роль</th><th>Пароль</th><th class="col-actions">Действия</th></tr>
          </thead>
          <tbody>
            <% if (users && users.length) { %>
              <% users.forEach(function(u) { %>
                <tr>
                  <td class="col-id" data-label="ID"><%= u.id %></td>
                  <td data-label="Email"><%= u.email %></td>
                  <td data-label="Имя"><%= u.name %> <%= u.surname %></td>
                  <td data-label="Роль">
                    <form action="/admin/users/<%= u.id %>/role" method="post" class="inline-form">
                      <select name="role" onchange="this.form.submit()">
                        <option value="customer" <%= u.role === 'customer' ? 'selected' : '' %>>Покупатель</option>
                        <option value="manager" <%= u.role === 'manager' ? 'selected' : '' %>>Менеджер</option>
                        <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Админ</option>
                      </select>
                    </form>
                  </td>
                  <td data-label="Пароль">
                    <form action="/admin/users/<%= u.id %>/password" method="post" class="password-reset-form">
                      <input type="password" name="password" placeholder="Новый пароль" minlength="6" required class="input-reset">
                      <button type="submit" class="btn btn-sm">Сбросить</button>
                    </form>
                  </td>
                  <td class="col-actions" data-label="Действия">
                    <div class="admin-actions">
                    <% if (u.id !== userId) { %>
                      <form action="/admin/users/<%= u.id %>/delete" method="post" class="inline-form" onsubmit="return confirm('Удалить пользователя?');">
                        <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                      </form>
                    <% } else { %>
                      <span class="admin-muted">Вы</span>
                    <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="6">Нет пользователей</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
    <section id="products" class="admin-section">
      <h2>Товары</h2>
      <form action="/admin/products" method="post" enctype="multipart/form-data" class="admin-form admin-product-form">
        <select name="category_id" required>
          <% if (categories && categories.length) { %>
            <% categories.forEach(function(c) { %>
              <option value="<%= c.id %>"><%= c.name %></option>
            <% }); %>
          <% } %>
        </select>
        <input type="text" name="name" placeholder="Название" required>
        <input type="text" name="article_number" placeholder="Артикул">
        <input type="number" name="price" placeholder="Цена (₽)" required step="0.01" min="0">
        <input type="number" name="stock" placeholder="Остаток" value="0" min="0">
        <textarea name="description" placeholder="Краткое описание товара" rows="2"></textarea>
        <input type="text" name="image_url" placeholder="Ссылка на фото">
        <label class="file-label"><span>Фото (файл)</span><input type="file" name="image" accept="image/*"></label>
        <label><input type="checkbox" name="is_new"> Новинка</label>
        <button type="submit" class="btn btn-solid">Добавить</button>
      </form>
      <div class="table-scroll">
        <table class="admin-table admin-table-products">
          <thead>
            <tr><th class="col-id">ID</th><th class="col-thumb">Фото</th><th>Название</th><th class="col-article">Артикул</th><th class="col-price">Цена</th><th class="col-stock">Остаток</th><th class="col-actions">Действия</th></tr>
          </thead>
          <tbody>
            <% if (products && products.length) { %>
              <% products.forEach(function(p) { %>
                <tr>
                  <td class="col-id" data-label="ID"><%= p.id %></td>
                  <td class="admin-thumb col-thumb" data-label="Фото"><% if (p.imageUrl) { %><img src="<%= p.imageUrl %>" alt="" loading="lazy" decoding="async"><% } else { %><span class="no-img">—</span><% } %></td>
                  <td class="col-name" data-label="Название"><%= p.name %></td>
                  <td class="col-article" data-label="Артикул"><%= p.articleNumber || '' %></td>
                  <td class="col-price" data-label="Цена"><%= p.price %></td>
                  <td class="col-stock" data-label="Остаток"><%= p.stock %></td>
                  <td class="col-actions" data-label="Действия">
                    <div class="admin-actions">
                      <a href="/admin/products/edit/<%= p.id %>" class="btn btn-sm">Изменить</a>
                      <form action="/admin/products/<%= p.id %>/delete" method="post" class="inline-form" onsubmit="return confirm('Удалить товар?');">
                        <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="7">Нет товаров</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
    <section id="orders" class="admin-section">
      <h2>Заказы</h2>
      <div class="table-scroll">
        <table class="admin-table admin-table-orders">
          <thead>
            <tr><th class="col-id">ID</th><th>Клиент</th><th>Email</th><th>Статус</th><th class="col-price">Сумма</th><th>Дата</th><th class="col-actions">Действия</th></tr>
          </thead>
          <tbody>
            <% if (orders && orders.length) { %>
              <% orders.forEach(function(o) { %>
                <tr>
                  <td class="col-id" data-label="ID"><%= o.id %></td>
                  <td data-label="Клиент"><%= o.userName %></td>
                  <td data-label="Email"><%= o.userEmail %></td>
                  <td data-label="Статус">
                    <form action="/admin/orders/<%= o.id %>/status" method="post" class="inline-form">
                      <select name="status" onchange="this.form.submit()">
                        <option value="new" <%= o.status === 'new' ? 'selected' : '' %>>Новый</option>
                        <option value="confirmed" <%= o.status === 'confirmed' ? 'selected' : '' %>>Сборка</option>
                        <option value="shipped" <%= o.status === 'shipped' ? 'selected' : '' %>>Готов к выдаче</option>
                        <option value="delivered" <%= o.status === 'delivered' ? 'selected' : '' %>>Выдан</option>
                        <option value="cancelled" <%= o.status === 'cancelled' ? 'selected' : '' %>>Отменён</option>
                      </select>
                    </form>
                  </td>
                  <td data-label="Сумма"><%= o.total %></td>
                  <td data-label="Дата"><%= new Date(o.createdAt).toLocaleDateString('ru-RU') %></td>
                  <td class="col-actions" data-label="Действия">
                    <div class="admin-actions">
                      <form action="/admin/delete-order/<%= o.id %>" method="post" class="inline-form" onsubmit="return confirm('Удалить заказ №<%= o.id %>?');">
                        <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="7">Нет заказов</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</main>
<%- include('partials/footer', { categories: typeof categories !== 'undefined' ? categories : [] }) %>
<% if (typeof flash !== 'undefined' && flash && String(flash).indexOf('Заказ') >= 0) { %>
<script>if (location.search.indexOf('order_deleted') >= 0) location.hash = 'orders';</script>
<% } %>
