<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo">МоторХаб</a>

    <div class="header-toolbar">
      <a href="/cart" class="header-cart-btn<%= typeof currentPath !== 'undefined' && currentPath === '/cart' ? ' active' : '' %>" aria-label="Корзина">
        <svg class="header-cart-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <span class="cart-count header-cart-count"><%= typeof cartCount !== 'undefined' ? cartCount : 0 %></span>
      </a>
      <button type="button" class="nav-toggle" id="navToggle" aria-label="Меню" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>

    <nav class="main-nav" id="mainNav" aria-label="Навигация">
      <a href="/parts" class="<%= typeof currentPath !== 'undefined' && currentPath === '/parts' ? 'active' : '' %>">Запчасти</a>
      <a href="/oils" class="<%= typeof currentPath !== 'undefined' && currentPath === '/oils' ? 'active' : '' %>">Масла</a>
      <a href="/about" class="<%= typeof currentPath !== 'undefined' && currentPath === '/about' ? 'active' : '' %>">О нас</a>
      <a href="/cart" class="cart-link <%= typeof currentPath !== 'undefined' && currentPath === '/cart' ? 'active' : '' %>">
        Корзина <span class="cart-count"><%= typeof cartCount !== 'undefined' ? cartCount : 0 %></span>
      </a>
      <a href="/account" class="<%= typeof currentPath !== 'undefined' && currentPath === '/account' ? 'active' : '' %>">Кабинет</a>
      <% if (typeof isStaff !== 'undefined' && isStaff) { %><a href="/admin" class="<%= typeof currentPath !== 'undefined' && currentPath === '/admin' ? 'active' : '' %>">Админ</a><% } %>
    </nav>

    <div class="header-right">
      <% if (typeof userId !== 'undefined' && userId) { %>
        <form action="/logout" method="post" style="margin:0;">
          <button type="submit" class="btn">Выйти</button>
        </form>
      <% } else { %>
        <a href="/login" class="btn">Войти</a>
      <% } %>
    </div>
  </div>
</header>
<script>
(function(){
  var btn=document.getElementById('navToggle');
  var nav=document.getElementById('mainNav');
  if(!btn||!nav)return;
  btn.addEventListener('click',function(){
    var open=nav.classList.toggle('open');
    btn.classList.toggle('open',open);
    btn.setAttribute('aria-expanded',open?'true':'false');
  });
  nav.querySelectorAll('a').forEach(function(a){
    a.addEventListener('click',function(){
      nav.classList.remove('open');
      btn.classList.remove('open');
      btn.setAttribute('aria-expanded','false');
    });
  });
})();
</script>
